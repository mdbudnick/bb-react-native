{
  "name": "BreathBox",
  "version": "2.1.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "ts:check": "tsc",
    "prebuild": "npx expo prebuild",
    "build:android": "eas build -p android",
    "submit:android": "eas submit -p android",
    "upload:android": "npm run prebuild && npm run build:android",
    "upload:full": "npm run prebuild && npm run build:android && npm run submit:android"
  },
  "dependencies": {
    "@babel/plugin-transform-export-namespace-from": "^7.18.9",
    "@expo/metro-runtime": "6.1.2",
    "@types/react": "19.2.10",
    "expo": "^54.0.33",
    "expo-status-bar": "^3.0.9",
    "link": "^2.1.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-native": "0.83.1",
    "react-native-reanimated": "^4.2.1",
    "@react-native-vector-icons/fontawesome": "^12.4.0",
    "@react-native-vector-icons/material-icons": "^12.4.0",
    "@react-native-vector-icons/ionicons": "^12.3.0",
    "react-native-web": "^0.21.2",
    "typescript": "^5.9.3",
    "expo-build-properties": "1.0.10",
    "expo-file-system": "19.0.21",
    "react-native-worklets": "0.7.2"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4"
  },
